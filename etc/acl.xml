<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <!--
                    With every other configuration section's, under Stores → Settings → Configuration,
                    where MageOS_Seo's own configuration resource also sits. The resource ID is
                    unchanged, so roles keep their grants.
                -->
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="MageOS_Aeo::config" title="AI Information &amp; Crawlers Configuration"
                                      translate="title" sortOrder="210"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
